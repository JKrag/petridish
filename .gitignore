# Node (the Raycast extension). Deliberately NOT path-anchored: these used to
# read `raycast/node_modules/`, which silently stopped matching the moment the
# extension moved to `integrations/raycast/` — and 3266 files of node_modules
# went into a commit before anyone noticed. Match by directory name so a future
# move cannot repeat it.
node_modules/
raycast-env.d.ts

